# PostgreSQL database used by Prisma.
# Local development uses SQLite instead: set DATABASE_URL="file:./dev.db"
# and use the npm run db:*:local scripts.
# On Vercel, the Neon integration injects DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct).
DATABASE_URL="postgresql://user:password@host:5432/birrwise?schema=public"

# Optional: only needed if prisma/schema.prisma uses directUrl.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/birrwise?schema=public"

# Dashboard/API login. Leave APP_USERNAME and APP_PASSWORD unset in local
# development to disable the login prompt. Production fails closed if either
# is missing, or if SESSION_SECRET is missing.
# APP_USERNAME="meron"
# APP_PASSWORD="replace-with-a-long-random-password"
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET="replace-with-a-random-secret"

# The destructive demo reset endpoint is disabled in production unless this
# is exactly "true". Leave it unset in Vercel.
# ALLOW_SETTINGS_RESET="false"

# API key required on the X-API-Key header with the SMS webhook.
# The app reads SMS_WEBHOOK_API_KEY first, then X-API-Key.
SMS_WEBHOOK_API_KEY="replace-with-a-long-random-secret"
