// Local-development mirror of prisma/schema.prisma.
// The deployed app uses PostgreSQL; this file lets `npm run dev` work with the
// SQLite file set in DATABASE_URL (default: file:./dev.db).
// Keep the models below in sync with prisma/schema.prisma.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           String        @id @default(cuid())
  name         String
  short        String        @unique
  type         String
  balance      Float         @default(0)
  icon         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[] @relation("AccountTransactions")
  transfersIn  Transaction[] @relation("TransferTo")
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  time        String
  accountId   String
  account     Account  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  toAccountId String?
  toAccount   Account? @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: SetNull)
  name        String
  category    String
  type        String   // 'income' | 'expense' | 'transfer'
  amount      Float
  icon        String
  note        String?
  label       String? // user's own annotation, separate from the system note
  fingerprint String?  @unique
  // Bank/wallet transaction reference (e.g. BOA FT…, Telebirr DKO…) used for
  // idempotent ingestion and receipt lookups.
  externalRef String?  @unique
  // Links the two account-side rows of one transfer (BOA out + Telebirr in).
  transferGroupId   String?
  // 'in' | 'out' for transfer rows that have no toAccountId. Incoming rows
  // add to the account balance; outgoing rows subtract.
  transferDirection String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([accountId])
  @@index([category])
  @@index([transferGroupId])
}

model WishlistItem {
  id            String    @id @default(cuid())
  name          String
  price         Float
  priority      Int       @default(2) // 1 high, 2 normal, 3 low
  category      String?
  note          String?
  url           String?
  status        String    @default("active") // active | purchased
  purchasedAt   DateTime?
  transactionId String?   // plain id; deleting a transaction keeps wishlist history
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, priority])
}

model Budget {
  id        String   @id @default(cuid())
  category  String   @unique
  icon      String
  limit     Float
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  icon      String
  parentId  String?
  parent    Category?  @relation("CategoryTaxonomy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTaxonomy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Rule {
  id        String   @id @default(cuid())
  keyword   String   @unique
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Staged operations for the MCP endpoint (2-level confirmation).
// A pending action is single-use and expires 10 minutes after staging.
model PendingAction {
  id         String    @id @default(cuid())
  kind       String // txn.create | txn.update | txn.delete | txn.setLabel | budget.delete | category.delete | rule.delete
  payload    String // JSON of the exact operation to execute
  tokenHash  String    @unique // sha256 of the confirmation token (raw token is never stored)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  consumedAt DateTime?
}
