{
  "name": "birrwise",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "prisma generate --schema prisma/schema.sqlite.prisma",
    "build": "prisma generate && prisma db push && next build",
    "build:local": "prisma generate --schema prisma/schema.sqlite.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:push:local": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:local": "prisma generate --schema prisma/schema.sqlite.prisma && tsx prisma/seed.ts",
    "backfill:boa": "tsx scripts/backfill-boa-receipts.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
